{
  "uid": "nekocafe-overview",
  "title": "NekoCafé Overview",
  "tags": ["nekocafe", "slo"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_requests_total, service)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "QPS（每服务）",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "P99 延迟",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "{{service}} p99"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))",
          "legendFormat": "{{service}} p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "错误率（5xx / 总）",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{service=~\"$service\",code=~\"5..\"}[5m])) / sum by (service) (rate(http_requests_total{service=~\"$service\"}[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.005 },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "资源使用（CPU + Mem）",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"nekocafe-.*\",pod=~\".*reservation.*|.*member.*\"}[5m]))",
          "legendFormat": "CPU {{pod}}"
        },
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"nekocafe-.*\",pod=~\".*reservation.*|.*member.*\"}) / 1024 / 1024",
          "legendFormat": "Mem (MB) {{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "金丝雀流量占比",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 6 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rollout_canary_weight{rollout=~\"nekocafe-prod-.*\"}",
          "legendFormat": "{{rollout}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "最近错误日志（Loki，可点 trace_id 跳 Tempo）",
      "gridPos": { "x": 8, "y": 16, "w": 16, "h": 6 },
      "datasource": "Loki",
      "targets": [
        {
          "expr": "{service=~\"reservation|member\"} | json | level=\"error\""
        }
      ]
    }
  ]
}
